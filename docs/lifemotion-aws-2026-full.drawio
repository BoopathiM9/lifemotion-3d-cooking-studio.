        <mxCell id="card_ops" value="&lt;b style='font-size:12px;color:#9B1C1C;'&gt;Security &amp; Monitoring Controls&lt;/b&gt;&#10;&lt;ul style='margin-top:4px;padding-left:14px;font-size:11px;'&gt;&#10;&lt;li&gt;&lt;b&gt;IAM Least Privilege:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;• Lambda S3: PutObject/GetObject on bucket&lt;br&gt;&amp;nbsp;&amp;nbsp;• Lambda Invoke: &lt;code&gt;lambda:InvokeFunction&lt;/code&gt; on Remotion&lt;/li&gt;&#10;&lt;li&gt;&lt;b&gt;CloudWatch Logs:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;• API Gateway request logs&lt;br&gt;&amp;nbsp;&amp;nbsp;• Lambda handler error tracing &amp; TTS debug&lt;br&gt;&amp;nbsp;&amp;nbsp;• Remotion Lambda render duration &amp; memory&lt;/li&gt;&#10;&lt;li&gt;&lt;b&gt;Alarms &amp; Throttling:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;• Concurrency limit protection on Lambda Free Tier&lt;/li&gt;&#10;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FCA5A5;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;fontColor=#334155;arcSize=6;" vertex="1" parent="1">
