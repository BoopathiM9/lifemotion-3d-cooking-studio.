        <mxCell id="card_s3_structure" value="&lt;b style='font-size:12px;color:#4D7C0F;'&gt;Amazon S3 Bucket Structure &amp; Object Hierarchy&lt;/b&gt;&#10;&lt;div style='font-family:monospace;font-size:10px;background:#ECFDF5;padding:8px;border-radius:4px;margin-top:6px;border:1px solid #A7F3D0;'&gt;&#10;s3://lifemotion-video-{aws-account-id}/&lt;br&gt;&#10;├── sites/cooking-studio/index.html &amp;nbsp;&amp;nbsp;&lt;span style='color:#059669;'&gt;[Remotion Webpack Bundle]&lt;/span&gt;&lt;br&gt;&#10;├── audio/preview-1730000000-abcde.mp3 &amp;nbsp;&lt;span style='color:#059669;'&gt;[Generated Voice Narration]&lt;/span&gt;&lt;br&gt;&#10;├── renders/{renderId}/chunks/frame-*.jpeg &lt;span style='color:#059669;'&gt;[Parallel Render Chunks]&lt;/span&gt;&lt;br&gt;&#10;└── out/{renderId}.mp4 &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#059669;'&gt;[Final 1080p/720p H.264 Film]&lt;/span&gt;&#10;&lt;/div&gt;&#10;&lt;ul style='margin-top:8px;padding-left:14px;font-size:11px;'&gt;&#10;&lt;li&gt;&lt;b&gt;Web Serving:&lt;/b&gt; Fast chunk reading by Remotion workers via S3 Acceleration&lt;/li&gt;&#10;&lt;li&gt;&lt;b&gt;Public &amp; Presigned URLs:&lt;/b&gt; Direct MP4 streaming to browser without loading Lambda memory&lt;/li&gt;&#10;&lt;li&gt;&lt;b&gt;Lifecycle Rules:&lt;/b&gt; Automatic expiration of temporary render chunks after 24 hours&lt;/li&gt;&#10;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BEF264;align=left;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=10;fontColor=#334155;arcSize=6;" vertex="1" parent="1">
