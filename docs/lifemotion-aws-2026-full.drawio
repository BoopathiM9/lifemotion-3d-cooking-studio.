        <mxCell id="card_lambda" value="&lt;b style='font-size:12px;color:#C05621;'&gt;Node.js 20 ESM (&lt;i&gt;lambda/handler.mjs&lt;/i&gt;)&lt;/b&gt;&#10;&lt;ul style='margin-top:4px;padding-left:14px;font-size:11px;'&gt;&#10;&lt;li&gt;&lt;b&gt;Recipe Matcher:&lt;/b&gt; Prompt matching (Biryani, Dosa, etc.)&lt;/li&gt;&#10;&lt;li&gt;&lt;b&gt;TTS Dispatcher:&lt;/b&gt; MsEdgeTTS MP3 speech synthesis&lt;/li&gt;&#10;&lt;li&gt;&lt;b&gt;S3 Uploader:&lt;/b&gt; Stores audio buffer to S3&lt;/li&gt;&#10;&lt;li&gt;&lt;b&gt;Render Initiator:&lt;/b&gt; Calls &lt;code&gt;renderMediaOnLambda()&lt;/code&gt;&lt;/li&gt;&#10;&lt;li&gt;&lt;b&gt;Status Poller:&lt;/b&gt; Queries &lt;code&gt;getRenderProgress()&lt;/code&gt;&lt;/li&gt;&#10;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDBA74;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;fontColor=#334155;arcSize=6;" vertex="1" parent="1">
