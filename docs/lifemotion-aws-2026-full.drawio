        <mxCell id="card_apigw" value="&lt;b style='font-size:12px;color:#9B1C1C;'&gt;HTTP API (CORS Enabled)&lt;/b&gt;&#10;&lt;ul style='margin-top:4px;padding-left:14px;font-size:11px;'&gt;&#10;&lt;li&gt;&lt;b&gt;GET /api/setup&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Tools &amp; cloud readiness check&lt;/li&gt;&#10;&lt;li&gt;&lt;b&gt;GET /api/recipes&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Recipe catalog &amp; voices list&lt;/li&gt;&#10;&lt;li&gt;&lt;b&gt;POST /api/plan&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Recipe steps &amp; voice preview&lt;/li&gt;&#10;&lt;li&gt;&lt;b&gt;POST /api/generate&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Triggers Remotion Lambda (202)&lt;/li&gt;&#10;&lt;li&gt;&lt;b&gt;GET /api/jobs/{id}&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Polls rendering progress %&lt;/li&gt;&#10;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FCA5A5;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;fontColor=#334155;arcSize=6;" vertex="1" parent="1">
