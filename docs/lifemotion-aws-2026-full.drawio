        <mxCell id="card_amplify" value="&lt;b style='font-size:12px;color:#C05621;'&gt;Static Web Hosting (CI/CD)&lt;/b&gt;&#10;&lt;ul style='margin-top:4px;padding-left:14px;font-size:11px;'&gt;&#10;&lt;li&gt;&lt;b&gt;Build Spec:&lt;/b&gt; &lt;i&gt;amplify.yml&lt;/i&gt;&lt;/li&gt;&#10;&lt;li&gt;Builds &lt;code&gt;studio3d&lt;/code&gt; web app&lt;/li&gt;&#10;&lt;li&gt;Global CloudFront CDN edge distribution&lt;/li&gt;&#10;&lt;li&gt;Automatic HTTPS &amp; SSL termination&lt;/li&gt;&#10;&lt;li&gt;Zero-downtime Git branch deployments&lt;/li&gt;&#10;&lt;li&gt;Static interface and recipe form delivery&lt;/li&gt;&#10;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDBA74;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;fontColor=#334155;arcSize=6;" vertex="1" parent="1">
