        <mxCell id="card_remotion" value="&lt;b style='font-size:12px;color:#C05621;'&gt;@remotion/lambda Distributed Engine&lt;/b&gt;&#10;&lt;ul style='margin-top:4px;padding-left:14px;font-size:11px;'&gt;&#10;&lt;li&gt;&lt;b&gt;Function:&lt;/b&gt; &lt;i&gt;remotion-render-4-0-539-mem2048mb-disk2048mb-120sec&lt;/i&gt;&lt;/li&gt;&#10;&lt;li&gt;&lt;b&gt;Specs:&lt;/b&gt; 2048 MB RAM, 2048 MB Temp Disk, 120s Timeout&lt;/li&gt;&#10;&lt;li&gt;&lt;b&gt;Composition:&lt;/b&gt; &lt;i&gt;LifeMotionCooking&lt;/i&gt; (React 19, Remotion 4.0)&lt;/li&gt;&#10;&lt;li&gt;&lt;b&gt;Concurrency:&lt;/b&gt; Parallel chunks (&lt;code&gt;framesPerLambda: 120&lt;/code&gt;)&lt;/li&gt;&#10;&lt;li&gt;&lt;b&gt;Engine:&lt;/b&gt; Headless Chromium + Canvas GPU-emulation&lt;/li&gt;&#10;&lt;li&gt;&lt;b&gt;Muxer:&lt;/b&gt; FFmpeg stitches video frames + audio to H.264/AAC MP4&lt;/li&gt;&#10;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDBA74;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;fontColor=#334155;arcSize=6;" vertex="1" parent="1">
