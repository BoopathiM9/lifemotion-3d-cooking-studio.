        <mxCell id="s3_desc" value="&lt;b style='font-size:10px;color:#0F172A;'&gt;remotionlambda-384875139605&lt;/b&gt;&#10;&lt;span style='font-size:9px;color:#64748B;'&gt;• /sites/cooking-studio/* (Remotion Bundle)&lt;br&gt;• /audio/preview-*.mp3 (Speech Narration)&lt;br&gt;• /renders/{id}/* (Render Chunks)&lt;br&gt;• /out/{id}.mp4 (Final Validated MP4)&lt;br&gt;• SSE-S3 &amp; 24h Lifecycle Cleanup Rule&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="835" y="303" width="235" height="100" as="geometry" />
        </mxCell>
