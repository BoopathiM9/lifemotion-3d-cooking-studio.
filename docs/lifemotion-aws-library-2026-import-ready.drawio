        <mxCell id="lbl_edge6" value="renderMediaOnLambda() &amp; Poll Status" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=9;fontStyle=1;fontColor=#2563EB;" vertex="1" parent="1">
          <mxGeometry x="1060" y="655" width="180" height="20" as="geometry" />
        </mxCell>
        <mxCell id="tier1_card" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="820" width="1620" height="150" as="geometry" />
        </mxCell>
        <mxCell id="tier1_title" value="Tier 1: Access &amp; Direct S3 Media Streaming" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="50" y="830" width="600" height="25" as="geometry" />
        </mxCell>
        <mxCell id="tier1_content" value="&lt;p style='margin:0;font-size:11px;line-height:1.7;color:#334155;'&gt;&#10;&lt;b style='color:#2563EB;'&gt;● User Access:&lt;/b&gt; Little Chefs &amp;amp; Parents open LifeMotion Cooking Studio web app hosted on AWS Amplify via CloudFront global CDN edge network.&lt;br&gt;&#10;&lt;b style='color:#16A34A;'&gt;● Direct S3 Streaming:&lt;/b&gt; Client web browser directly plays synthesized voice narration MP3 preview and streams/downloads completed 1080p/720p H.264 video files directly from Amazon S3 (bypassing 10MB API Gateway/Lambda payload limits).&#10;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="860" width="1580" height="90" as="geometry" />
        </mxCell>
        <mxCell id="tier2_card" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="990" width="1620" height="150" as="geometry" />
        </mxCell>
        <mxCell id="tier2_title" value="Tier 2: Ingress, Recipe Planning &amp; Voice Synthesis" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="50" y="1000" width="600" height="25" as="geometry" />
        </mxCell>
        <mxCell id="tier2_content" value="&lt;p style='margin:0;font-size:11px;line-height:1.7;color:#334155;'&gt;&#10;&lt;b style='color:#9333EA;'&gt;● API Gateway Dispatch:&lt;/b&gt; Browser issues lightweight REST calls (&lt;code&gt;/setup&lt;/code&gt;, &lt;code&gt;/recipes&lt;/code&gt;, &lt;code&gt;/plan&lt;/code&gt;, &lt;code&gt;/generate&lt;/code&gt;, &lt;code&gt;/jobs/{id}&lt;/code&gt;) with CORS handling to serverless API routes.&lt;br&gt;&#10;&lt;b style='color:#EA580C;'&gt;● Serverless Orchestration:&lt;/b&gt; Node.js 20 ESM Lambda Orchestrator parses user prompts, matches alias catalog (10 core recipes), contacts Microsoft Edge TTS for high-fidelity Jenny/Aria/Tamil Pallavi neural speech, and uploads audio to S3.&#10;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="1030" width="1580" height="90" as="geometry" />
        </mxCell>
        <mxCell id="tier3_card" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="1160" width="1620" height="150" as="geometry" />
        </mxCell>
        <mxCell id="tier3_title" value="Tier 3: Distributed Remotion Rendering &amp; Video Production" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="50" y="1170" width="600" height="25" as="geometry" />
        </mxCell>
        <mxCell id="tier3_content" value="&lt;p style='margin:0;font-size:11px;line-height:1.7;color:#334155;'&gt;&#10;&lt;b style='color:#0D9488;'&gt;● AI Recipe Grounding:&lt;/b&gt; Amazon Bedrock with Amazon Nova Micro extracts structured cooking steps and ingredients for unfamiliar prompts with structured recipe generation and Tamil translation.&lt;br&gt;&#10;&lt;b style='color:#2563EB;'&gt;● Distributed Cloud Video Farm:&lt;/b&gt; Remotion Lambda Cluster renders React 19 cartoon cooking scenes in parallel across multi-worker Chromium instances (&lt;code&gt;framesPerLambda: 120&lt;/code&gt;), stitches audio with FFmpeg into H.264 MP4, and saves directly to S3.&#10;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="1200" width="1580" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>