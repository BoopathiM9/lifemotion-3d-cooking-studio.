        </mxCell>
        <mxCell id="apigw_desc" value="&lt;b style='font-size:11px;color:#0F172A;'&gt;REST / HTTP API&lt;/b&gt;&#10;&lt;span style='font-size:9px;color:#64748B;'&gt;• CORS Preflight Handlers&lt;br&gt;• GET /api/setup, /api/recipes&lt;br&gt;• POST /api/plan (Preview)&lt;br&gt;• POST /api/generate (202 Job)&lt;br&gt;• GET /api/jobs/{id} (Poll Status)&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="580" y="405" width="190" height="105" as="geometry" />
        </mxCell>
