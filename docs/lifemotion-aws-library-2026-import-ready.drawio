        <mxCell id="amplify_name" value="&lt;b style='font-size:11px;color:#0F172A;'&gt;LifeMotion Studio Web&lt;/b&gt;&#10;&lt;span style='font-size:9px;color:#64748B;'&gt;App ID: &lt;b&gt;d2cookingstudio&lt;/b&gt;&lt;br&gt;Branch: main&lt;br&gt;React 19 + Remotion 4.0 Web App&lt;br&gt;Global CloudFront Edge&lt;br&gt;HTTPS / Custom Domain&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
