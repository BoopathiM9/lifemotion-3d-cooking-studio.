          <mxGeometry x="927" y="460" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lambda_title" value="AWS Lambda Handlers" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontColor=#EA580C;" vertex="1" parent="1">
          <mxGeometry x="835" y="512" width="235" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lambda_sub" value="Node.js 20.x ESM (lambda/handler.mjs)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="835" y="530" width="235" height="18" as="geometry" />
        </mxCell>
        <mxCell id="lambda_desc" value="&lt;div style='text-align:left;padding-left:14px;font-size:9.5px;color:#334155;'&gt;&#10;&lt;b style='color:#0F172A;'&gt;1. RecipePlannerLambda&lt;/b&gt;&lt;br&gt;&#10;• Catalog Alias Matching (Biryani, Dosa, etc.)&lt;br&gt;&#10;• Speech Generation (msedge-tts dispatch)&lt;br&gt;&#10;• Direct S3 Upload for Preview MP3&lt;br&gt;&#10;&lt;br&gt;&#10;&lt;b style='color:#0F172A;'&gt;2. RenderDispatchLambda&lt;/b&gt;&lt;br&gt;&#10;• Calls &lt;code&gt;renderMediaOnLambda()&lt;/code&gt;&lt;br&gt;&#10;• Composition: &lt;i&gt;LifeMotionCooking&lt;/i&gt;&lt;br&gt;&#10;• Polls status with &lt;code&gt;getRenderProgress()&lt;/code&gt;&lt;br&gt;&#10;• Returns real-time percentage % to UI&#10;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="835" y="555" width="235" height="175" as="geometry" />
        </mxCell>
        <mxCell id="card_ai" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14B8A6;strokeWidth=1.5;shadow=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1190" y="215" width="380" height="235" as="geometry" />
        </mxCell>
        <mxCell id="icon_ai" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#0D9488;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1">
          <mxGeometry x="1355" y="230" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ai_title" value="Edge TTS &amp;amp; Amazon Bedrock" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontColor=#0D9488;" vertex="1" parent="1">
          <mxGeometry x="1195" y="282" width="370" height="20" as="geometry" />
        </mxCell>
        <mxCell id="ai_sub" value="Neural Speech &amp;amp; AWS Recipe Intelligence" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1195" y="302" width="370" height="18" as="geometry" />
        </mxCell>
        <mxCell id="ai_desc" value="&lt;span style='font-size:9.5px;color:#475569;'&gt;• &lt;b&gt;Microsoft Edge TTS:&lt;/b&gt; High-fidelity neural speech streaming&lt;br&gt;&amp;nbsp;&amp;nbsp;• &lt;code&gt;en-US-JennyNeural&lt;/code&gt; &amp;amp; &lt;code&gt;en-US-AriaNeural&lt;/code&gt; (English)&lt;br&gt;&amp;nbsp;&amp;nbsp;• &lt;code&gt;ta-IN-PallaviNeural&lt;/code&gt; (Tamil narration)&lt;br&gt;• &lt;b&gt;Amazon Bedrock:&lt;/b&gt; Amazon Nova Micro recipe planning and translation&lt;br&gt;• Structured ingredients and child-friendly cooking steps&lt;br&gt;• Narration MP3 saved directly into Amazon S3&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="1215" y="325" width="340" height="115" as="geometry" />
        </mxCell>
        <mxCell id="card_remotion" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;shadow=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1190" y="485" width="380" height="255" as="geometry" />
        </mxCell>
        <mxCell id="icon_remotion" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#2563EB;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="1355" y="500" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="remotion_title" value="Remotion Lambda Cluster" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontColor=#2563EB;" vertex="1" parent="1">
          <mxGeometry x="1195" y="552" width="370" height="20" as="geometry" />
        </mxCell>
        <mxCell id="remotion_sub" value="remotion-render-4-0-539 (Distributed Cloud Video Rendering)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1195" y="572" width="370" height="18" as="geometry" />
        </mxCell>
        <mxCell id="remotion_desc" value="&lt;span style='font-size:9.5px;color:#475569;'&gt;• &lt;b&gt;Parallel Video Chunks:&lt;/b&gt; 120 frames per Lambda worker instance&lt;br&gt;• &lt;b&gt;Compute Specs:&lt;/b&gt; 2048 MB RAM, 2048 MB /tmp Disk, 120s Timeout&lt;br&gt;• &lt;b&gt;Headless Chromium Engine:&lt;/b&gt; Executes React 19 Remotion compositions&lt;br&gt;• &lt;b&gt;Built-in FFmpeg Muxer:&lt;/b&gt; Combines frames + speech MP3 into H.264/AAC MP4&lt;br&gt;• Writes final film to &lt;code&gt;s3://remotionlambda-.../out/{id}.mp4&lt;/code&gt;&lt;br&gt;• Highly scalable on AWS Lambda Free Tier (400,000 GB-sec/mo)&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="1215" y="595" width="340" height="135" as="geometry" />
        </mxCell>
