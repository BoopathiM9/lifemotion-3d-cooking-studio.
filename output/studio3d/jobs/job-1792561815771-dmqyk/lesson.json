{"duration": 67.05600000000001, "voice": "en-US-AriaNeural", "steps": [{"key": "welcome", "text": "Hello, little chefs! I'm MAYA. Let's make a crispy masala dosa.", "title": "welcome", "start": 0, "speechEnd": 8.400000000000002, "end": 8.580000000000002}, {"key": "safe", "text": "Wash your hands. Ask a grown-up to use the hot stove and utensils.", "title": "safe", "start": 8.580000000000002, "speechEnd": 15.240000000000002, "end": 15.420000000000002}, {"key": "ingredients", "text": "We need dosa batter, cooked potato filling, a little oil, and chutney.", "title": "ingredients", "start": 15.420000000000002, "speechEnd": 21.012, "end": 21.192}, {"key": "pour", "text": "Scoop up the batter. Gently pour it into the middle of the warm pan.", "title": "pour", "start": 21.192, "speechEnd": 27.42, "end": 27.6}, {"key": "spread", "text": "Spread the batter in gentle circles. Start in the middle and move outwards.", "title": "spread", "start": 27.6, "speechEnd": 34.164, "end": 34.344}, {"key": "cook", "text": "Add a little oil. Let the dosa cook until the edges are golden.", "title": "cook", "start": 34.344, "speechEnd": 40.332, "end": 40.512}, {"key": "fill", "text": "Spoon the cooked potato filling onto one side. Leave room around the edge.", "title": "fill", "start": 40.512, "speechEnd": 47.316, "end": 47.496}, {"key": "fold", "text": "Slide the spatula under the empty half. Lift gently and fold it over the filling.", "title": "fold", "start": 47.496, "speechEnd": 54.612, "end": 54.792}, {"key": "serve", "text": "Slide the dosa onto a plate. Pull the spatula away and turn off the stove. Let it cool before tasting. Well done!", "title": "serve", "start": 54.792, "speechEnd": 66.876, "end": 67.05600000000001}], "segments": [{"text": "Hello, little chefs!", "key": "welcome", "start": 0, "end": 2.568, "measuredAudioDuration": 2.568}, {"text": "I'm MAYA.", "key": "welcome", "start": 2.748, "end": 4.956, "measuredAudioDuration": 2.208}, {"text": "Let's make a crispy masala dosa.