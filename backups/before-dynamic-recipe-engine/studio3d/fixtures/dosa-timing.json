{
  "duration": 65.016,
  "steps": [
    {
      "key": "welcome",
      "text": "Hello, little chefs! I'm MAYA. Let's make a crispy masala dosa.",
      "title": "welcome",
      "start": 0,
      "speechEnd": 8.280000000000001,
      "end": 8.46
    },
    {
      "key": "safe",
      "text": "Wash your hands. Ask a grown-up to use the hot stove and utensils.",
      "title": "safe",
      "start": 8.46,
      "speechEnd": 14.736,
      "end": 14.916
    },
    {
      "key": "ingredients",
      "text": "We need dosa batter, cooked potato filling, a little oil, and chutney.",
      "title": "ingredients",
      "start": 14.916,
      "speechEnd": 20.484,
      "end": 20.664
    },
    {
      "key": "pour",
      "text": "Scoop up the batter. Gently pour it into the middle of the warm pan.",
      "title": "pour",
      "start": 20.664,
      "speechEnd": 26.46,
      "end": 26.64
    },
    {
      "key": "spread",
      "text": "Spread the batter in gentle circles. Start in the middle and move outwards.",
      "title": "spread",
      "start": 26.64,
      "speechEnd": 33.084,
      "end": 33.264
    },
    {
      "key": "cook",
      "text": "Add a little oil. Let the dosa cook until the edges are golden.",
      "title": "cook",
      "start": 33.264,
      "speechEnd": 39.156,
      "end": 39.336
    },
    {
      "key": "fill",
      "text": "Spoon the cooked potato filling onto one side. Leave room around the edge.",
      "title": "fill",
      "start": 39.336,
      "speechEnd": 45.827999999999996,
      "end": 46.007999999999996
    },
    {
      "key": "fold",
      "text": "Slide the spatula under the empty half. Lift gently and fold it over the filling.",
      "title": "fold",
      "start": 46.007999999999996,
      "speechEnd": 52.931999999999995,
      "end": 53.111999999999995
    },
    {
      "key": "serve",
      "text": "Slide the dosa onto a plate. Pull the spatula away and turn off the stove. Let it cool before tasting. Well done!",
      "title": "serve",
      "start": 53.111999999999995,
      "speechEnd": 64.836,
      "end": 65.016
    }
  ],
