# AWS Cloud Rendering Configuration
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1

# Amazon Bedrock GenAI Configuration
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# Remotion Lambda Configuration
REMOTION_AWS_REGION=us-east-1
REMOTION_BUCKET_NAME=your_remotion_s3_bucket
REMOTION_FUNCTION_NAME=your_remotion_lambda_function
REMOTION_SERVE_URL=https://your-s3-bucket.s3.us-east-1.amazonaws.com/sites/cooking-studio/index.html
